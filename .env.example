# SKPL Agent — Production Environment Configuration
# Copy this file to .env and fill in your values
# docker compose --env-file .env up -d
#
# NOTE: docker-compose.yml reads variables from this file and maps them
# to the correct Python env vars (SKPL_CORE_*, SKPL_AUTH_*, etc.)
# for the backend container. See comments below for the mapping.

# =============================================================================
# Database (mapped to: SKPL_CORE_DATABASE_URL)
# =============================================================================
SKPL_DB_USER=skpl
SKPL_DB_PASSWORD=change-me-in-production
SKPL_DB_NAME=skpl_agent

# =============================================================================
# Redis (mapped to: SKPL_CORE_REDIS_URL)
# =============================================================================
SKPL_REDIS_PASSWORD=change-me-in-production

# =============================================================================
# Authentication (mapped to: SKPL_AUTH_MODE, SKPL_AUTH_JWT_SECRET, etc.)
# =============================================================================
# Auth mode: "jwt" (production) or "none" (development, X-User-ID header)
SKPL_AUTH_MODE=jwt
# JWT secret for token signing (generate with: openssl rand -hex 32)
# docker-compose maps this to SKPL_AUTH_JWT_SECRET in the container
SKPL_JWT_SECRET=change-me-to-a-random-secret
# docker-compose maps this to SKPL_AUTH_JWT_ALGORITHM in the container
SKPL_JWT_ALGORITHM=HS256
# docker-compose maps this to SKPL_AUTH_JWT_EXPIRY_HOURS in the container
SKPL_JWT_EXPIRE_HOURS=168

# =============================================================================
# Admin Account (auto-created on first startup if not exists)
# (read directly by _lifespan.py via os.environ)
# =============================================================================
SKPL_ADMIN_USER=admin
SKPL_ADMIN_PASS=change-me-in-production

# =============================================================================
# CORS (mapped to: SKPL_CORE_CORS_ORIGINS)
# JSON array of allowed origins (pydantic-settings requires JSON format)
# =============================================================================
SKPL_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# =============================================================================
# API Base URL for frontend (mapped to: VITE_API_BASE_URL)
# =============================================================================
SKPL_API_BASE_URL=http://localhost:8000

# =============================================================================
# Server (mapped to: SKPL_CORE_LOG_LEVEL, SKPL_CORE_PORT)
# =============================================================================
SKPL_LOG_LEVEL=INFO
SKPL_BACKEND_PORT=8000
SKPL_FRONTEND_PORT=4173

# =============================================================================
# Mem0 LLM (for long-term memory)
# (mapped to: SKPL_MEM0_LLM_PROVIDER, SKPL_MEM0_LLM_MODEL, etc.)
# =============================================================================
SKPL_MEM0_LLM_PROVIDER=deepseek
SKPL_MEM0_LLM_MODEL=deepseek-chat
SKPL_MEM0_LLM_API_KEY=

# =============================================================================
# Mem0 Embedder (for vector search)
# (mapped to: SKPL_MEM0_EMBEDDER_PROVIDER, etc.)
# =============================================================================
SKPL_MEM0_EMBEDDER_PROVIDER=openai
SKPL_MEM0_EMBEDDER_MODEL=voyage-3-lite
SKPL_MEM0_EMBEDDER_API_KEY=
SKPL_MEM0_EMBEDDER_BASE_URL=https://api.voyageai.com/v1

# =============================================================================
# Global Embedding (for knowledge base)
# (mapped to: SKPL_GLOBAL_EMBEDDING_PROVIDER, etc.)
# =============================================================================
SKPL_GLOBAL_EMBEDDING_PROVIDER=openai
SKPL_GLOBAL_EMBEDDING_MODEL=voyage-3-lite
SKPL_GLOBAL_EMBEDDING_API_KEY=
SKPL_GLOBAL_EMBEDDING_BASE_URL=https://api.voyageai.com/v1

# =============================================================================
# Milvus / MinIO (Knowledge Base)
# =============================================================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-in-production

# =============================================================================
# LLM API Keys
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=

# =============================================================================
# Firecrawl
# =============================================================================
FIRECRAWL_API_KEY=

# =============================================================================
# Optional: pgAdmin
# =============================================================================
PGADMIN_EMAIL=admin@skpl.dev
PGADMIN_PASSWORD=change-me-in-production

# =============================================================================
# Optional: Observability (OpenTelemetry)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=