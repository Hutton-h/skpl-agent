# SKPL Agent Frontend Dockerfile
# Multi-stage build for production deployment
#
# Usage:
#   docker build -f Dockerfile.frontend -t skpl-agent-frontend .
#   docker run -p 80:80 skpl-agent-frontend

# ===== Stage 1: Build =====
FROM node:22-alpine AS builder

WORKDIR /app

# Use npmmirror for China network
RUN npm config set registry https://registry.npmmirror.com

# Install pnpm 9 (NOT 11 — pnpm 11+ ignores onlyBuiltDependencies in package.json)
RUN npm install -g pnpm@9.15.0

# Copy package files
COPY frontend/package.json ./
COPY frontend/pnpm-lock.yaml* ./

# Configure pnpm for China network + build scripts
RUN printf 'registry=https://registry.npmmirror.com\nfetch-timeout=120000\nshamefully-hoist=true\n' > .npmrc && \
    pnpm install --no-frozen-lockfile

# Copy source code
COPY frontend/ ./

# Build for production (skip TypeScript project references)
RUN pnpm vite build

# ===== Stage 2: Nginx Runtime =====
FROM nginx:1.27-alpine AS runtime

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]