# SKPL Agent Frontend Dockerfile
# Multi-stage build for production deployment
#
# Usage:
#   docker build -f Dockerfile.frontend -t skpl-agent-frontend .
#   docker run -p 80:80 skpl-agent-frontend

# ===== Stage 1: Build =====
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@11.17.0

# Copy package files (pnpm-lock.yaml is optional)
COPY frontend/package.json ./
COPY frontend/pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Copy source code
COPY frontend/ ./

# Build for production
RUN pnpm build

# ===== Stage 2: Nginx Runtime =====
FROM nginx:1.27-alpine AS runtime

# Copy built assets (includes PWA: manifest.json, sw.js from public/)
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]