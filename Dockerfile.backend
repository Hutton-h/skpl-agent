# SKPL Agent Backend Dockerfile
# Multi-stage build for production deployment
#
# Usage:
#   docker build -f Dockerfile.backend -t skpl-agent-backend .
#   docker run -p 8000:8000 skpl-agent-backend

# ===== Stage 1: Build =====
FROM python:3.12-slim AS builder

WORKDIR /app

# Use Aliyun mirror for Debian packages (China network)
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Use Aliyun pip mirror for faster downloads
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/

# Copy project files
COPY pyproject.toml README.md LICENSE ./
COPY backend/ backend/

# Install the package with service dependencies
RUN pip install --no-cache-dir -e ".[service,storage-sql,context]"

# ===== Stage 2: Runtime =====
FROM python:3.12-slim AS runtime

WORKDIR /app

# Use Aliyun mirror for Debian packages (China network)
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources

# Install runtime system dependencies (tzdata is required for zoneinfo/APScheduler)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --from=builder /app/backend /app/backend
COPY --from=builder /app/pyproject.toml /app/README.md /app/

# Create non-root user
RUN useradd --create-home --shell /bin/bash skpl && \
    chown -R skpl:skpl /app

USER skpl

# Create data directory
RUN mkdir -p /app/data

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SKPL_DATA_DIR=/app/data \
    SKPL_HOST=0.0.0.0 \
    SKPL_PORT=8000 \
    TZ=Asia/Shanghai

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start the server with production settings
CMD ["sh", "-c", "uvicorn skpl_agent.app._app:app --host 0.0.0.0 --port 8000 --workers ${SKPL_WORKERS:-4} --log-level ${SKPL_LOG_LEVEL:-info}"]